FROM mcr.microsoft.com/playwright/python:v1.49.0-noble

# Prevent interactive prompts during package installation
ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV DISPLAY=:99
ENV RUNNING_IN_DOCKER=1

# Install Xvfb, x11vnc, noVNC, websockify, supervisor
RUN apt-get update && apt-get install -y --no-install-recommends \
    xvfb \
    x11vnc \
    novnc \
    websockify \
    supervisor \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Fix noVNC index symlink if needed
RUN if [ ! -f /usr/share/novnc/index.html ]; then \
      ln -s /usr/share/novnc/vnc.html /usr/share/novnc/index.html; \
    fi

WORKDIR /app

# Install python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Ensure Playwright browser binaries are present
RUN playwright install chromium

# Copy application code
COPY . .

# Configuration for supervisor
COPY supervisord.conf /etc/supervisor/conf.d/supervisord.conf

# Expose FastAPI (8000) and noVNC web streaming (6080)
EXPOSE 8000 6080

CMD ["/usr/bin/supervisord", "-c", "/etc/supervisor/conf.d/supervisord.conf"]
